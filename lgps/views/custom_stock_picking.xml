<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record model="ir.ui.view" id="custom_lgps_stock_picking_view">
    <field name="name">lgps.custom.stock.picking</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

       <xpath expr="//field[@name='priority']" position="after">
         <field name="return_id" invisible="1"/>
       </xpath>

      <xpath expr="//sheet//div[@name='button_box']" position="inside">
        <button class="oe_stat_button"
                type="object"
                icon="fa-cubes"
                string="Mover a Virtual"
                name="move_lines_to_virtual_location"
                invisible="not return_id"
        />
                <!--groups="lgps.lgps_group_field_service_material_uninstalled"-->
      </xpath>
    </field>
  </record>

</odoo>
