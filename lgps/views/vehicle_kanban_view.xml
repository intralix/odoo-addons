<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record model="ir.ui.view" id="vehicle_kanban_view">
    <field name="name">lgps.vehicle.kanban</field>
    <field name="model">lgps.vehicle</field>
    <field name="arch" type="xml">
      <kanban default_group_by="stage_id" class="o_kanban_small_column" records_draggable="false" group_create="false">
        <field name="color"/>
        <field name="state"/>
        <field name="vehicle_type_id"/>
        <field name="activity_state" />
        <field name="activity_ids" />
        <progressbar field="kanban_state"
                     colors='{
                      "done":"success",
                      "blocked":"danger",
                      "normal":"muted"}'
                     sum_fields="num_records"
        />
        <templates>
          <t t-name="kanban-menu">
              <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
              <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
              <ul class="oe_kanban_colorpicker" data-field="color"/>
          </t>

          <t t-name="kanban-box">
              <div class="oe_kanban_content flex-grow-1">

                <div class="oe_kanban_details">
                  <strong class="o_kanban_record_title">
                    <field name="name"/> / <field name="plates"/>
                  </strong>
                </div>
                <div class="o_kanban_record_body">
                  <div><field name="client_id"/><div/>
                    <div><field name="brand"/> / <field name="model"/></div>
                    <div><field name="vehicle_type_id"/></div>
                  </div>
                </div>

                <div class="o_kanban_record_bottom">
                  <div class="oe_kanban_bottom_left">
                    <field name="priority" widget="priority"/>
                      <div class="o_kanban_inline_block">
                        <field name="activity_ids" widget="kanban_activity"/>
                      </div>
                  </div>

                  <div class="oe_kanban_bottom_right">
                    <field name="kanban_state" widget="kanban_state_selection"/>
                  </div>
                </div> <!-- o_kanban_record_bottom -->

                <div class="oe_clear"/>

              </div><!-- oe_kanban_content -->
          </t>
        </templates>
      </kanban>
    </field>
  </record>
</odoo>
