<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record model="ir.ui.view" id="device_form_view">
    <field name="name">device.form</field>
    <field name="model">lgps.device</field>
    <field name="arch" type="xml">
      <form string="Gps Device Form">
        <header>
          <field name="state" widget="statusbar" options="{'clickable':False}"/>
        </header>

        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button"
                      type="object"
                      icon="fa-shopping-bag"
                      name="action_counter_subscription_button">
                <field string="Subscriptions" name="subscriptions_count" widget="statinfo"/>
              </button>

              <button class="oe_stat_button"
                      type="object"
                      icon="fa-life-ring"
                      name="action_counter_tickets_button">
                <field string="Tickets" name="helpdesk_tickets_count" widget="statinfo"/>
              </button>

              <button class="oe_stat_button"
                      type="object"
                      icon="fa-globe"
                      name="action_counter_tracking_button">
                <field string="Tracking" name="tracking_count" widget="statinfo"/>
              </button>

              <button class="oe_stat_button"
                      type="object"
                      icon="fa-globe"
                      name="action_counter_fsm_button">
                <field string="Services" name="fsm_ids_count" widget="statinfo"/>
              </button>

          </div>

          <group>
            <group string="Device Info">
              <separator/>
              <field name="name"/>
              <field name="nick"/>
              <field name="product_id"/>
              <field name="serial_number_id" domain="[('product_id', '=', product_id)]"/>
              <field name="imei"/>
              <field name="idf"/>
              <field name="device_pin"/>
              <field name="vehicle_id"/>
            </group>
            <group string="More Info">
              <separator/>
              <field name="client_id"/>
              <field name="administrative_status"/>
              <field name="stage_id"/>
              <field name="platform_list_id"/>

              <field name="invoice_id"/>
              <field name="cell_chip_id"/>
              <field name="purchase_date"/>
              <field name="installation_date"/>
              <field name="sales_order_id"/>
            </group>
          </group>

          <notebook>
            <page string="Warranty">
              <group>
                <group string="Warranty Information">
                  <separator/>
                  <field name="warranty_start_date"/>
                  <field name="warranty_end_date"/>
                </group>
                <group string="Term">
                  <separator/>
                  <field name="warranty_term"/>
                </group>
              </group>
            </page>

            <page string="Services">
              <group>
                <group string="Funciones">
                  <group>
                  <field name="tracking"/>
                  <field name="fuel"/>
                  <field name="fuel_hall"/>
                  <field name="temperature"/>
                  <field name="collective"/>
                </group>
                  <group>
                    <field name="fleetrun"/>
                    <field name="scanner"/>
                    <field name="logistic"/>
                    <field name="electronics"/>
                  </group>
                </group>
                <group string="Complementos">
                  <group>
                    <field name="speaker"/>
                    <field name="anti_jammer_blocker"/>
                    <field name="smart_blocker"/>
                    <field name="blocker"/>
                    <field name="padlock"/>
                    <field name="disengagement_sensor"/>
                  </group>
                  <group>
                    <field name="solar_panel"/>
                    <field name="sheet"/>
                    <field name="opening_sensor"/>
                    <field name="ibutton"/>
                    <field name="microphone"/>
                  </group>
                </group>
              </group>
            </page>

            <page string="Accessories">
              <field name="accessory_ids" readonly="1">
                <tree create="0" delete="0">
                  <field name="name"/>
                  <field name="client_id"/>
                  <field name="historic_serial_number" readonly="1"/>
                  <field name="serial_number_id"/>
                  <field name="installation_date"/>
                  <field name="status"/>
                  <field name="product_id"/>
                </tree>
              </field>
            </page>


            <page string="Posicionamiento">
              <group>
                <group string="Last Report">
                  <separator/>
                  <field name="datetime_gps"/>
                  <field name="datetime_server"/>
                </group>
                <group string="Mapa">
                  <separator/>
                  <field name="last_position" widget="url" text="See on the Map"/>
                  <field name="last_report"/>
                </group>
              </group>
            </page>

            <page string="Más Información">
              <group>
                <group string="Sistema">
                  <separator/>
                  <field name="odoo_version" readonly="1"/>
                </group>
                <group string="Más">
                  <separator/>
                  <field name="historic_serial_number" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>

        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="device_search_view">
    <field name="name">device.search</field>
    <field name="model">lgps.device</field>
    <field name="arch" type="xml">
      <search>
        <filter string="Activos" name="active_devices"  domain="[('state', '!=', 'installed')]"/>
        <filter string="Baja" name="inactive_devices"  domain="[('administrative_status', '=', 'drop')]"/>
        <separator/>
        <filter string="Comodatos" name="comodato_devices"  domain="[('administrative_status', '=', 'comodato')]"/>
        <filter string="Demos" name="demo_devices"  domain="[('administrative_status', '=', 'demo')]"/>
        <separator/>
        <filter string="RMA" name="devices_rmas"  domain="[('administrative_status', '=', 'rma')]"/>
        <filter string="Vendidos" name="devices_solds"  domain="[('administrative_status', '=', 'sold')]"/>
        <field name="name"/>
        <field name="nick"/>
        <field name="client_id"/>
        <field name="administrative_status"/>
        <field name="stage_id"/>
        <field name="cell_chip_id"/>
        <field name="historic_serial_number"/>
        <field name="serial_number_id"/>
        <field name="imei"/>
        <field name="installation_date"/>
        <field name="platform_list_id"/>
        <field name="product_id"/>
        <field name="warranty_end_date"/>
        <field name="message_ids" string="Chatter Messages" filter_domain="[('message_ids.body', 'ilike', self)]"/>
        <group expand="1" string="Group By">
          <filter string="Cliente" name="cliente" context="{'group_by':'client_id'}"/>
          <filter string="Producto" name="producto" context="{'group_by':'product_id'}"/>
          <separator orientation="vertical" />
          <filter string="Plataforma" name="platform_list_id" context="{'group_by':'platform_list_id'}"/>
          <filter string="Estatus" name="administrative_status" context="{'group_by':'administrative_status'}"/>
          <filter string="Estatus Operativo" name="state" context="{'group_by':'stage_id'}"/>
          <separator orientation="vertical" />
          <filter string="Fecha Instalación" name="installation_date" context="{'group_by':'installation_date'}"/>
          <filter string="Fin de Garantía" name="end_warranty" context="{'group_by':'warranty_end_date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="device_tree_view">
    <field name="name">device.tree</field>
    <field name="model">lgps.device</field>
    <field name="arch" type="xml">
      <tree string="GpsDevices Tree"
            decoration-muted="state=='cancel'"
            decoration-info="state != 'cancel' and (last_report&gt;48)"
            decoration-warning="state != 'cancel' and (last_report&gt;72)"
            decoration-danger="state != 'cancel' and (last_report&gt;120)">
        <field name="name"/>
        <field name="nick"/>
        <field name="client_id"/>
        <field name="administrative_status"/>
        <field name="state"/>
        <field name="cell_chip_id"/>
        <field name="historic_serial_number"/>
        <field name="serial_number_id"/>
        <field name="imei"/>
        <field name="installation_date"/>
        <field name="platform_list_id"/>
        <field name="product_id"/>
        <field name="warranty_end_date"/>
        <field name="last_report" invisible="1"/>
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="device_list_action">
    <field name="name">GpsDevices</field>
    <field name="res_model">lgps.device</field>
    <field name="view_mode">tree,form,kanban</field>
  </record>

  <!-- Menu items -->
  <menuitem id="gps_devices_menu" name="Gps Devices" parent="lgps_menu" action="device_list_action" sequence="10"/>
</odoo>
