<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record model="ir.ui.view" id="vehicle_type_list_form_view">
    <field name="name">vehicle_type_list.form</field>
    <field name="model">lgps.vehicle_type</field>
    <field name="arch" type="xml">
      <form string="Vehicle Type list Form">
        <sheet>
          <group>
            <group string="Vehicle Type Info">
              <separator/>
              <field name="name"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>

        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="vehicle_type_list_search_view">
    <field name="name">vehicle_type_list.search</field>
    <field name="model">lgps.vehicle_type</field>
    <field name="arch" type="xml">
      <search>
        <filter string="Activos" name="active_vehicle_types"  domain="[('active', '=', True)]"/>
        <separator/>
        <field name="name"/>
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="vehicle_type_list_tree_view">
    <field name="name">vehicle_type_list.tree</field>
    <field name="model">lgps.vehicle_type</field>
    <field name="arch" type="xml">
      <tree string="Vehicle Type Tree" editable="top">
        <field name="name"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="vehicle_type_list_action">
    <field name="name">Vehicle Types</field>
    <field name="res_model">lgps.vehicle_type</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menu items -->
  <menuitem id="vehicle_type_list_menu"
            name="Vehicle Types"
            parent="vehicles_root_conf_menu"
            action="vehicle_type_list_action"/>
</odoo>
